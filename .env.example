# claude-guard configuration. Copy to .env and adjust.
# All guard settings use the GUARD_ prefix. An empty value means "not set" (the default applies).

# Anthropic API key for the LLM judge (read from here or the environment). If empty, the SDK
# uses its default credential lookup. The proxy never uses it: it forwards each client's own key.
ANTHROPIC_API_KEY=

# Path to the policy file.
GUARD_POLICY_PATH=policy.yaml

# Behaviour when the engine itself fails: "closed" blocks, "open" allows.
GUARD_FAIL_MODE=closed

# Model used by the LLM judge (a Haiku-family model is recommended).
GUARD_JUDGE_MODEL=claude-haiku-4-5

# Proxy listen address and upstream API.
GUARD_HOST=127.0.0.1
GUARD_PORT=8787
# TLS for the client -> proxy connection (PEM files). Set both or neither; the client then uses
# ANTHROPIC_BASE_URL=https://... . Required when GUARD_HOST is not a loopback address.
GUARD_TLS_CERTFILE=
GUARD_TLS_KEYFILE=
# Allow plain HTTP on a non-loopback GUARD_HOST. Only for TLS terminated in front of the proxy
# (Caddy, nginx, service mesh); logs an insecure_bind warning at startup.
GUARD_ALLOW_INSECURE_BIND=false
GUARD_UPSTREAM_URL=https://api.anthropic.com
# Upstream request timeout in seconds.
GUARD_UPSTREAM_TIMEOUT=600

# Streaming mode: "buffer" inspects before replaying SSE, "audit" streams live and inspects afterwards.
GUARD_STREAM_MODE=buffer

# /v1/* endpoints the proxy cannot inspect (e.g. Files API uploads): "block" answers HTTP 403,
# "allow" forwards them without inspection. Messages, count_tokens and batches are always inspected.
GUARD_PASSTHROUGH=block

# Enable the LLM judge inside Claude Code hooks (slower; heuristics only by default).
GUARD_HOOK_LLM=false

# Proxy limits in bytes. Larger request bodies get HTTP 413 (raise for big Message Batches); a
# buffered stream above the stream limit is not inspected and GUARD_FAIL_MODE applies.
GUARD_MAX_BODY_BYTES=33554432
GUARD_MAX_STREAM_BYTES=33554432

# Shared secret clients must send in the x-claude-guard-token header (every endpoint except
# /healthz). Empty: no client authentication. Set it whenever the proxy is reachable from the
# network. Claude Code: ANTHROPIC_CUSTOM_HEADERS="x-claude-guard-token: <token>".
GUARD_PROXY_TOKEN=

# Audit log location, rotation size in bytes (0 disables rotation) and rotated copies kept.
GUARD_AUDIT_PATH=logs/audit.jsonl
GUARD_AUDIT_MAX_BYTES=10485760
GUARD_AUDIT_BACKUPS=5

# Alerts: POST to this webhook for verdicts at least as strict as GUARD_ALERT_MIN_ACTION
# (warn | redact | block). https only (http for loopback); the URL is treated as a secret.
# Format: json (masked audit record) or slack ({"text": ...} for incoming webhooks).
GUARD_ALERT_WEBHOOK_URL=
GUARD_ALERT_FORMAT=json
GUARD_ALERT_MIN_ACTION=block
GUARD_ALERT_TIMEOUT=5
GUARD_ALERT_MAX_PER_MINUTE=30

# Log level: DEBUG, INFO, WARNING, ERROR.
GUARD_LOG_LEVEL=INFO
